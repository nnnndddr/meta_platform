# SMTP — email-уведомления при создании записей
# Если SMTP_HOST не задан, письма выводятся в консоль (demo-режим)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@meta-platform.local
SMTP_USE_SSL=false

# Email-адреса demo-пользователей
DEMO_EMAIL_ALICE=alice@example.com
DEMO_EMAIL_BOB=bob@example.com
DEMO_EMAIL_CAROL=carol@example.com
DEMO_EMAIL_DAVE=dave@example.com
